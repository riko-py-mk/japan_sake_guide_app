# Copy this file to .streamlit/secrets.toml and fill in your API keys
# For Streamlit Cloud, add these secrets in the app settings

OPENAI_API_KEY = "your-openai-api-key"
TAVILY_API_KEY = "your-tavily-api-key"

# Instagram credentials (optional) - Required for hashtag search via Instaloader
# Note: Instagram may rate-limit or block accounts that use automated tools.
# Use a dedicated account for this purpose, not your personal account.
# See: https://instaloader.github.io/troubleshooting.html
INSTAGRAM_USERNAME = "your-instagram-username"
INSTAGRAM_PASSWORD = "your-instagram-password"
