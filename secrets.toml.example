# Copy this file to .streamlit/secrets.toml and fill in your API keys
# For Streamlit Cloud, add these secrets in the app settings

OPENAI_API_KEY = "your-openai-api-key"
TAVILY_API_KEY = "your-tavily-api-key"
GOOGLE_MAPS_API_KEY = "your-google-maps-api-key"

# Instagram Basic Display API (optional)
# To get these credentials, create a Facebook Developer account and set up Instagram Basic Display API
INSTAGRAM_ACCESS_TOKEN = "your-instagram-access-token"
